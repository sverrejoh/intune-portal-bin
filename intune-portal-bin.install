_notes() {
    cat <<'MSG'

==> intune-portal-bin (Arch fork)
    Intune only supports Ubuntu/RHEL, so the machine has to look like
    Ubuntu 24.04 and a handful of system settings have to be right
    before enrollment works. Nothing below is done by the package; run
    the helper once as your normal user (it uses sudo where needed):

        intune-arch-setup          # prepares the system, idempotent
        intune-doctor              # verifies every known requirement

    Then log out and back in (group membership + keyring), and enroll:

        intune-portal

    Guide and troubleshooting: README.md in the package repository.
MSG
}

post_install() {
    _notes
}

post_upgrade() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    cat <<'MSG'
==> intune-portal-bin upgraded. If the device is enrolled nothing else
    is needed. Run `intune-doctor` if anything misbehaves.
MSG
}

post_remove() {
    cat <<'MSG'
==> intune-portal-bin removed. The Ubuntu os-release spoof, the tpm2-tss
    pin and the pacman hook were set up by intune-arch-setup and are
    still in place; run `intune-arch-setup --undo` to revert them.
MSG
}
